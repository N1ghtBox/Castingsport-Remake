{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for the main window",
	"windows": [
		"main"
	],
	"permissions": [
		"core:default",
		"opener:default",
		"fs:default",
		"fs:allow-create",
		"fs:allow-write-text-file",
		"fs:allow-write",
		"fs:allow-write-file",
		"updater:default",
		"global-shortcut:allow-is-registered",
		"global-shortcut:allow-register",
		"global-shortcut:allow-unregister",
		"log:default",
		{
			"identifier": "fs:scope",
			"allow": [
				{
					"path": "$APPDATA"
				},
				{
					"path": "$APPDATA/**"
				},
				{
					"path": "$RESOURCE"
				},
				{
					"path": "$RESOURCE/**"
				}
			]
		}
	]
}