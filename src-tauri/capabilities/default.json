{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for the main window",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"opener:default",
		"fs:default",
		"fs:allow-create",
		"fs:allow-write-text-file",
		"fs:allow-write",
		{
			"identifier": "fs:scope",
			"allow": [
				{ "path": "$APPDATA" },
				{ "path": "$APPDATA/**" },
				{ "path": "$RESOURCE" },
				{ "path": "$RESOURCE/**" }
			]
		}
	]
}
